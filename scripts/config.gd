extends RefCounted
## Конфигурация приложения. Файл лежит в репозитории, ключи по умолчанию пустые.
##
## Ключ необязателен: сервис панорам его не проверяет, приложение работает без
## него (подробности в README). Если ключ всё же вписать — он попадёт и в
## репозиторий, и в APK (оттуда извлекается): для публикации нужен прокси.

const YANDEX_API_KEY := ""
const YANDEX_STATIC_KEY := ""

## Ключ Яндекса привязан к Referer; в нативном клиенте выставляем его вручную.
const YANDEX_REFERER := "http://localhost:5173/"

const DEFAULT_LON := 37.6208
const DEFAULT_LAT := 55.7539

## Максимальная ширина equirect-текстуры уровня (по ширине уровня тайлов).
## С секторами это не про всю панораму: ограничивает, до какого уровня пускать LOD.
const MAX_TEXTURE_WIDTH := 8192.0

## Предельный размер одной секторной текстуры, px (защита от огромных уровней).
const SECTOR_MAX_TEX := 8192

## Ручная поправка азимута панорамы, градусы.
const YAW_FIX_DEG := 0.0

## --- Ленивая загрузка тайлов: сектора сферы + LOD ---

## Целевая сетка секторов (сферу режем по тайлам самого грубого тира LOD).
const SECTOR_COLS := 8
const SECTOR_ROWS := 4

## Сколько самых крупных уровней грузить лениво (тиры LOD).
const LOD_TIERS := 2

## Подразбиение сектора на квады — чтобы сфера не была гранёной. При приближении
## сектор растягивается в zoom раз, и грани становятся видны на плавных градиентах
## (небо): при 16 квадах грань на максимальном зуме — ~8° против ~45° при 4.
const SECTOR_SUBDIV := 16

## Радиус патчей относительно фоновой сферы (чуть внутри, чтобы не было z-fight).
const PATCH_RADIUS_SCALE := 0.999

## LOD, градусы. HOT — угол до ЦЕНТРА сектора: внутри него топовый уровень
## (плюс сектор под центром экрана — всегда топ, см. pano_stream._demand_tier).
## WARM — угол до БЛИЖАЙШЕГО КРАЯ сектора: до него уровень на тир ниже, дальше фон.
## Оба порога делятся на текущий zoom: приближение растягивает сектор наружу, и
## картина уровней на экране остаётся той же (до ~30° топ, дальше на тир ниже).
const PATCH_LOD_HOT_DEG := 30.0
const PATCH_LOD_WARM_DEG := 65.0
const PATCH_LOD_HYST_DEG := 8.0

## Интервал пересчёта приоритетов (мс) и число одновременных сборок сектора.
const STREAM_INTERVAL_MS := 250
const MAX_INFLIGHT := 2

## Лимит резидентных текстур секторов (остальные выгружаются в фон).
const MAX_RESIDENT_PATCHES := 24

## На сколько грейдов выше самого мелкого уровня брать быстрый/предзагруженный
## фон панорамы (для мгновенного раскрытия при переходе). 0 — самый мелкий.
const INCOMING_LOW_STEP := 1

## Шарпен на приближении: цифровое растяжение уровня выглядит мыленно, высокие
## частоты подтягиваются тем сильнее, чем больше зум. Сила = clamp((zoom-1)*RATE,
## 0, MAX); 0 — выключить. Значения >0.8 дают заметные ореолы.
const ZOOM_SHARPEN_RATE := 0.30
const ZOOM_SHARPEN_MAX := 0.55

## --- Планшет: тайловая карта, оверлей панорам, поиск ---

## Размер UI-планшета (SubViewport) и, соответственно, окна карты в пикселях.
## Планшет подносят близко к лицу, поэтому держим высокое разрешение — иначе
## текст и карта мылятся. Каждая пересборка — декод PNG-тайлов на CPU.
const MAP_VIEW_W := 1280
const MAP_VIEW_H := 886

## Базовая карта: тайловая пирамида Яндекса в EPSG:3395 (256 px, одна сетка с
## оверлеем). Шардированные хосты (01.) у базовой карты НЕ работают — только этот.
const MAP_TILE_URL := "https://core-renderer-tiles.maps.yandex.ru/tiles"

## Оверлей панорам (линии покрытия + иконки): core-stv-renderer, шардируется по
## хостам 01..04. `v` непустой (значение не проверяется), `l=stv` или `l=sta`.
const MAP_OVERLAY_URL := "https://%s.core-stv-renderer.maps.yandex.net/2.x/tiles"
const MAP_OVERLAY_HOSTS := ["01", "02", "03", "04"]

## Оверлей показываем только на «городских» зумах — иначе каша из линий и точек.
const OVERLAY_MIN_ZOOM := 13

const MAP_ZOOM_MIN := 3.0
const MAP_ZOOM_MAX := 19.0
## Запас вокруг показываемого окна карты: внутри него сдвиг рисуем смещением
## готовой текстуры (плавно), а пересборку запускаем только при выходе за запас.
const MAP_MARGIN := 160
## Скорость непрерывного зума правым стиком, «лог2-уровня» в секунду.
const MAP_ZOOM_RATE := 1.1
## Кривая стика: |x|^curve (1 — линейно, >1 — мягче у центра).
const MAP_STICK_CURVE := 1.5
## Мёртвая зона стика зума.
const MAP_ZOOM_DEADZONE := 0.15

## Параллельных загрузок тайлов карты/оверлея и размер LRU-кэша тайлов.
const MAP_TILE_WORKERS := 6
const MAP_TILE_CACHE := 320
## Троттлинг пересборки карты при сдвиге/зуме, мс.
const MAP_REFRESH_MS := 160

## Цвет шевронов соседей воздушной панорамы.
const AIR_MARKER_COLOR := Color(0.30, 0.75, 1.0)

## Подсказки поиска: неофициальная ручка, работает без ключа.
const SUGGEST_URL := "https://suggest-maps.yandex.ru/suggest-geo"
const SEARCH_DEBOUNCE_SEC := 0.35
